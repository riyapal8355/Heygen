# ==============================================================================
# HeyZen Infrastructure & Backend Environment Variables
# ==============================================================================

# Application Settings
APP_ENV=development
APP_NAME=HeyZen Backend
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL Database Configuration
POSTGRES_DB=heyzen
POSTGRES_USER=heyzen
POSTGRES_PASSWORD=your_dev_postgres_password_here
DATABASE_URL=postgresql+asyncpg://heyzen:your_dev_postgres_password_here@127.0.0.1:5432/heyzen

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3 Object Storage Configuration
MINIO_ROOT_USER=heyzen_admin
MINIO_ROOT_PASSWORD=your_dev_minio_password_here
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=heyzen_admin
MINIO_SECRET_KEY=your_dev_minio_password_here
MINIO_BUCKET=heyzen-assets
MINIO_REGION=us-east-1

# S3 Client Aliases (Backwards-compatible)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=heyzen_admin
S3_SECRET_KEY=your_dev_minio_password_here
S3_BUCKET=heyzen-assets

# Authentication & Security
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_for_local_testing_only_replace_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
