# ==============================================================================
# HeyZen Showcase Deployment — Environment Variable Reference (.env.example)
# ==============================================================================
# Use this template to configure local development or showcase cloud environments
# (Vercel for Frontend, Render for Backend/Worker).
# NEVER commit real credentials, passwords, or private keys to git.
# ==============================================================================

# ==============================================================================
# SECTION 1: PUBLIC VARIABLES (Vercel Frontend Build & Client Runtime)
# ==============================================================================
# The public base URL of the FastAPI backend reachable by the user's browser.
# Local Development: http://127.0.0.1:8000
# Showcase / Production: https://your-heyzen-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ==============================================================================
# SECTION 2: SERVER-ONLY VARIABLES (Render FastAPI Backend & Celery Worker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 Application Metadata & Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=HeyZen Backend
APP_VERSION=0.1.0
DEBUG=true
PORT=8000

# ------------------------------------------------------------------------------
# 2.2 PostgreSQL Database
# ------------------------------------------------------------------------------
# Async SQLAlchemy database connection URI.
# Local: postgresql+asyncpg://heyzen:your_dev_postgres_password_here@127.0.0.1:5432/heyzen
# Render Managed / Cloud: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://heyzen:your_dev_postgres_password_here@127.0.0.1:5432/heyzen
POSTGRES_DB=heyzen
POSTGRES_USER=heyzen
POSTGRES_PASSWORD=your_dev_postgres_password_here

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 2.3 Redis (Job Queue Broker, Cache, Pub/Sub)
# ------------------------------------------------------------------------------
# Local: redis://127.0.0.1:6379/0
# Render Managed / Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 2.4 Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
# Endpoint for binary asset uploads (video, audio, avatars, images)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=heyzen_admin
MINIO_SECRET_KEY=your_dev_minio_password_here
MINIO_BUCKET=heyzen-assets
MINIO_REGION=us-east-1

# Backwards-compatible aliases if S3_* is preferred by cloud provider
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=heyzen_admin
S3_SECRET_KEY=your_dev_minio_password_here
S3_BUCKET=heyzen-assets

# ------------------------------------------------------------------------------
# 2.5 Authentication & Session Security (JWT & Cookies)
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing JWT tokens (min 32 characters in production)
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_for_local_testing_only_replace_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for cross-site browser sessions:
# Local development (HTTP): COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Cloud Showcase (Vercel HTTPS -> Render HTTPS): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 2.6 CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional single frontend deployment origin (e.g. Vercel domain)
FRONTEND_URL=

# ------------------------------------------------------------------------------
# 2.7 AI Engine Modes & Providers
# ------------------------------------------------------------------------------
# Modes: "mock" (for cloud showcase without GPU host) or "real" (with GPU worker)
AI_PROVIDER_MODE=mock
AI_RUNTIME_MODE=mock
AI_PREFERRED_DEVICE=auto
AI_MODEL_CACHE_DIR=models_cache
AI_ALLOW_AUTO_DOWNLOAD=false
AI_VERIFY_CHECKSUMS=true
AI_INFERENCE_TIMEOUT_SECONDS=120

DEFAULT_LLM_PROVIDER=mock
DEFAULT_TTS_PROVIDER=mock
DEFAULT_ASR_PROVIDER=mock
DEFAULT_TRANSLATION_PROVIDER=mock
DEFAULT_AVATAR_PROVIDER=gpu_avatar
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_MATTING_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2.8 Media Subprocesses & FFmpeg
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SECONDS=300
MAX_MEDIA_INPUT_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=3600.0
MIN_VIDEO_DURATION_SECONDS=5.0
