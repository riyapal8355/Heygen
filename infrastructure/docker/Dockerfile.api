# ==============================================================================
# HeyZen Autonomous AI Video Studio — Production FastAPI API Container
# ==============================================================================
FROM python:3.11-slim-bookworm

LABEL maintainer="HeyZen Engineering <engineering@heyzen.ai>"
LABEL description="HeyZen Production REST/SSE API Server"

# 1. Environment Configuration
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH="/home/heyzen/.local/bin:${PATH}"

# 2. System Packages & Media Binaries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 3. Create Unprivileged User (UID 10001)
RUN groupadd -g 10001 heyzen && \
    useradd -u 10001 -g heyzen -m -s /bin/bash heyzen

WORKDIR /app
RUN chown -R heyzen:heyzen /app

# 4. Install Lean Python Dependencies (No PyTorch/CUDA)
COPY --chown=heyzen:heyzen requirements.txt /app/
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir -r requirements.txt

# 5. Copy Application Source Code
COPY --chown=heyzen:heyzen app /app/app
COPY --chown=heyzen:heyzen scripts /app/scripts
COPY --chown=heyzen:heyzen alembic.ini /app/alembic.ini
COPY --chown=heyzen:heyzen alembic /app/alembic

USER heyzen
EXPOSE 8000

# 6. Container Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

# 7. Start Production Uvicorn Server with Multiple Workers
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]
